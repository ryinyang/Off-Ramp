<?xml version="1.0" encoding="utf-8"?>
<!--
  Off-Ramp does not need window content or specific event streams: the service exists solely
  so the OS grants it the "bound accessibility service" exemption to Android 10+'s background
  activity-launch restriction, which is what lets OffRampAccessibilityService.fireBreakActivity()
  forcibly pull focus to the break screen (see architecture_and_risks.md, "Android Focus-Switch
  Mechanism"). Foreground-app detection itself is done separately via UsageStatsManager.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:canRetrieveWindowContent="false"
  android:notificationTimeout="500"
  android:description="@string/accessibility_service_description" />
