{
  "name": "@off-ramp/extension",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "plasmo dev --target=firefox-mv2",
    "build": "plasmo build --target=firefox-mv2",
    "package": "plasmo package --target=firefox-mv2",
    "lint": "tsc --noEmit"
  },
  "manifest": {
    "name": "Off-Ramp",
    "description": "Opal-Style Doomscrolling Interrupter",
    "permissions": [
      "tabs",
      "storage",
      "<all_urls>"
    ],
    "host_permissions": [
      "<all_urls>"
    ]
  },
  "dependencies": {
    "@off-ramp/core": "*",
    "@off-ramp/ui": "*",
    "plasmo": "^0.89.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.5"
  }
}
